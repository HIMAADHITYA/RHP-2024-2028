import java.util.*;

public class Main {
    static int M, N;
    static char[][] grid;
    static int[][][] dist;

    static boolean valid(int r, int c, int o) {
        if (r < 0 || c < 0 || r >= M || c >= N)
            return false;

        if (grid[r][c] == 'H')
            return false;

        if (o == 0) {
            if (c + 1 >= N || grid[r][c + 1] == 'H')
                return false;
        } else {
            if (r + 1 >= M || grid[r + 1][c] == 'H')
                return false;
        }

        return true;
    }

    static boolean freeSquare(int r, int c) {
        if (r < 0 || c < 0 || r + 1 >= M || c + 1 >= N)
            return false;

        for (int i = r; i <= r + 1; i++) {
            for (int j = c; j <= c + 1; j++) {
                if (grid[i][j] == 'H')
                    return false;
            }
        }

        return true;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        M = sc.nextInt();
        N = sc.nextInt();

        grid = new char[M][N];

        ArrayList<int[]> start = new ArrayList<>();
        ArrayList<int[]> target = new ArrayList<>();

        for (int i = 0; i < M; i++) {
            for (int j = 0; j < N; j++) {
                grid[i][j] = sc.next().charAt(0);

                if (grid[i][j] == 's')
                    start.add(new int[]{i, j});

                if (grid[i][j] == 'S')
                    target.add(new int[]{i, j});
            }
        }

        Collections.sort(start, (a, b) -> {
            if (a[0] != b[0])
                return a[0] - b[0];
            return a[1] - b[1];
        });

        Collections.sort(target, (a, b) -> {
            if (a[0] != b[0])
                return a[0] - b[0];
            return a[1] - b[1];
        });

        int sr = start.get(0)[0];
        int sc1 = start.get(0)[1];

        int tr = target.get(0)[0];
        int tc = target.get(0)[1];

        int so;
        int to;

        if (start.get(0)[0] == start.get(1)[0])
            so = 0;
        else
            so = 1;

        if (target.get(0)[0] == target.get(1)[0])
            to = 0;
        else
            to = 1;

        dist = new int[M][N][2];

        for (int i = 0; i < M; i++)
            for (int j = 0; j < N; j++)
                Arrays.fill(dist[i][j], -1);

        Queue<int[]> q = new LinkedList<>();

        q.add(new int[]{sr, sc1, so});
        dist[sr][sc1][so] = 0;

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        while (!q.isEmpty()) {
            int[] cur = q.poll();

            int r = cur[0];
            int c = cur[1];
            int o = cur[2];

            int steps = dist[r][c][o];

            if (r == tr && c == tc && o == to) {
                System.out.println(steps);
                return;
            }

            // Move up, down, left, right
            for (int k = 0; k < 4; k++) {
                int nr = r + dr[k];
                int nc = c + dc[k];

                if (valid(nr, nc, o) && dist[nr][nc][o] == -1) {
                    dist[nr][nc][o] = steps + 1;
                    q.add(new int[]{nr, nc, o});
                }
            }

            // Rotate horizontal -> vertical
            if (o == 0) {
                for (int nr : new int[]{r - 1, r}) {
                    if (freeSquare(nr, c)) {
                        for (int nc : new int[]{c, c + 1}) {
                            if (dist[nr][nc][1] == -1) {
                                dist[nr][nc][1] = steps + 1;
                                q.add(new int[]{nr, nc, 1});
                            }
                        }
                    }
                }
            }

            // Rotate vertical -> horizontal
            else {
                for (int nc : new int[]{c - 1, c}) {
                    if (freeSquare(r, nc)) {
                        for (int nr : new int[]{r, r + 1}) {
                            if (dist[nr][nc][0] == -1) {
                                dist[nr][nc][0] = steps + 1;
                                q.add(new int[]{nr, nc, 0});
                            }
                        }
                    }
                }
            }
        }

        System.out.println("Impossible");
    }
}
